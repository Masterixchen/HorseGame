@page "/pferd/{Id:guid}"
@using Core
@using Web.Speicher
@inject SpielSitzung Sitzung
@inject Inhaltsdatenbank Inhalte
@inject NavigationManager Navigation

<PageTitle>@(_pferd?.Name ?? "Pferd")</PageTitle>

@if (!Sitzung.Geladen)
{
    <p>Lädt...</p>
}
else if (_pferd == null)
{
    <p>Dieses Pferd gibt es nicht (mehr).</p>
}
else
{
    var rasse = Inhalte.HoleRasse(_pferd.RasseId);

    <a href="/" class="zurueck-link">← zurück zum Stall</a>

    <div class="detail-kopf seltenheit-@_pferd.Seltenheit.ToString().ToLowerInvariant()">
        <h1>@_pferd.Name</h1>
        <div class="detail-unterzeile">
            @rasse.Name · @_pferd.Geschlecht · @_pferd.Farbe · @_pferd.AlterInJahren(DateTime.UtcNow) Jahre
        </div>
        <div class="detail-badges">
            <span class="seltenheit-abzeichen">@_pferd.Seltenheit</span>
            <span class="blutlinie-abzeichen">Blutlinienstufe @_pferd.Blutlinienstufe</span>
        </div>
    </div>

    <section class="detail-abschnitt">
        <h2>Werte</h2>
        @if (!_pferd.AlleMerkmaleBekannt)
        {
            <p class="fohlen-hinweis">🌱 Die Werte zeigen sich erst vollständig, wenn alle Merkmale aufgedeckt sind.</p>
        }
        else
        {
            @foreach (var (typ, stat) in _pferd.Werte.Alle())
            {
                <div class="wert-zeile-gross">
                    <span class="wert-name">@typ</span>
                    <div class="balken-hintergrund balken-gross">
                        <div class="balken-potenzial" style="width:@(Prozent(stat.Potenzial))%"></div>
                        <div class="balken-aktuell" style="width:@(Prozent(stat.Aktuell))%"></div>
                    </div>
                    <span class="wert-zahl">@stat.Aktuell.ToString("F1") / @stat.Potenzial.ToString("F1")</span>
                </div>
            }
        }
        <div class="wert-zeile-gross">
            <span class="wert-name">Kondition</span>
            <div class="balken-hintergrund balken-gross">
                <div class="balken-kondition" style="width:@(Prozent(_pferd.Kondition))%"></div>
            </div>
            <span class="wert-zahl">@_pferd.Kondition.ToString("F0")</span>
        </div>
        <div class="wert-zeile-gross">
            <span class="wert-name">Stimmung</span>
            <div class="balken-hintergrund balken-gross">
                <div class="balken-stimmung" style="width:@(Prozent(_pferd.Stimmung))%"></div>
            </div>
            <span class="wert-zahl">@_pferd.Stimmung.ToString("F0")</span>
        </div>
    </section>

    <section class="detail-abschnitt">
        <h2>Merkmale</h2>
        @foreach (var merkmal in _pferd.AlleMerkmale())
        {
            @if (!merkmal.Bekannt)
            {
                <div class="merkmal-zeile merkmal-verborgen">
                    <div class="merkmal-kopf">
                        <span class="merkmal-art">???</span>
                        <span class="merkmal-name">deckt sich auf am @merkmal.Aufdeckzeitpunkt!.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            }
            else
            {
                var definition = Inhalte.HoleMerkmal(merkmal.DefinitionId);
                <div class="merkmal-zeile">
                    <div class="merkmal-kopf">
                        <span class="merkmal-art merkmal-art-@definition.Art.ToString().ToLowerInvariant()">@definition.Art</span>
                        <span class="merkmal-name">@definition.Name @merkmal.StufeRoemisch()</span>
                    </div>
                    <div class="merkmal-beschreibung">@definition.Beschreibung</div>
                    @foreach (var effekt in merkmal.Effekte)
                    {
                        <div class="effekt-zeile">
                            <span class="effekt-attribut">@effekt.Attribut</span>
                            <span class="effekt-wert">@effekt.Wert.ToString("+0.0;-0.0")%</span>
                            <div class="positions-balken">
                                <div class="positions-marker" style="left:@((effekt.Position * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="effekt-bereich">(@effekt.Min.ToString("+0.0;-0.0") bis @effekt.Max.ToString("+0.0;-0.0"))</span>
                        </div>
                    }
                </div>
            }
        }
    </section>

    <section class="detail-abschnitt">
        <h2>Ausrüstung</h2>
        @foreach (var slot in Enum.GetValues<AusruestungsSlot>())
        {
            var ausgeruestetId = _pferd.Ausgeruestet.GetValueOrDefault(slot);
            var ausgeruestet = ausgeruestetId != Guid.Empty ? Sitzung.Zustand.Ausruestungen.FirstOrDefault(a => a.Id == ausgeruestetId) : null;
            <div class="merkmal-zeile">
                <div class="merkmal-kopf">
                    <span class="merkmal-art">@slot</span>
                    <span class="merkmal-name">@(ausgeruestet != null ? Inhalte.HoleAusruestung(ausgeruestet.DefinitionId).Name : "leer")</span>
                </div>
                @if (ausgeruestet != null)
                {
                    <button class="knopf-sekundaer" @onclick="() => Ablegen(slot)">Ablegen</button>
                }
                else
                {
                    var verfuegbar = VerfuegbareAusruestung(slot);
                    @if (verfuegbar.Count == 0)
                    {
                        <p class="fohlen-hinweis">nichts im Lager für diesen Slot - siehe Markt</p>
                    }
                    else
                    {
                        <div class="training-formular">
                            <select @bind="_ausgewaehlteAusruestung[slot]">
                                @foreach (var a in verfuegbar)
                                {
                                    <option value="@a.Id">@Inhalte.HoleAusruestung(a.DefinitionId).Name</option>
                                }
                            </select>
                            <button class="knopf-primaer" @onclick="() => Anlegen(slot)">Anlegen</button>
                        </div>
                    }
                }
            </div>
        }
    </section>

    @if (_pferd.Traechtigkeit != null)
    {
        <section class="detail-abschnitt">
            <h2>Trächtigkeit</h2>
            <p>Geburt am <strong>@_pferd.Traechtigkeit.Geburtstermin.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>.</p>
        </section>
    }
    else if (_pferd.Anmeldung != null)
    {
        <section class="detail-abschnitt">
            <h2>Wettkampf-Anmeldung</h2>
            <p>Angemeldet für <strong>@_pferd.Anmeldung.Klasse.Name</strong>, Termin @_pferd.Anmeldung.Zeitpunkt.ToLocalTime().ToString("dd.MM.yyyy HH:mm").</p>
        </section>
    }
    else if (!_pferd.AlleMerkmaleBekannt)
    {
        <section class="detail-abschnitt">
            <h2>Training</h2>
            <p>Solange nicht alle Merkmale aufgedeckt sind, ist noch kein gezieltes Training möglich.</p>
        </section>
    }
    else
    {
        <section class="detail-abschnitt">
            <h2>Training</h2>
            @if (_pferd.AktivesTraining != null)
            {
                <p>Trainiert gerade <strong>@_pferd.AktivesTraining.Ziel</strong>, fertig am @_pferd.AktivesTraining.Ende.ToLocalTime().ToString("dd.MM.yyyy HH:mm").</p>
            }
            else
            {
                <div class="training-formular">
                    <select @bind="_trainingsZiel">
                        @foreach (var typ in Enum.GetValues<StatTyp>())
                        {
                            <option value="@typ">@typ</option>
                        }
                    </select>
                    <button class="knopf-primaer" @onclick="TrainingStarten">Training starten (4-8 Std.)</button>
                </div>
            }
        </section>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Pferd? _pferd;
    private StatTyp _trainingsZiel = StatTyp.Tempo;
    private readonly Dictionary<AusruestungsSlot, string> _ausgewaehlteAusruestung =
        Enum.GetValues<AusruestungsSlot>().ToDictionary(s => s, _ => "");

    protected override async Task OnInitializedAsync()
    {
        if (!Sitzung.Geladen)
            await Sitzung.LadenOderErzeugenAsync();

        _pferd = Sitzung.Zustand.Pferde.FirstOrDefault(p => p.Id == Id);
    }

    private async Task TrainingStarten()
    {
        if (_pferd == null) return;
        _pferd.StarteTraining(_trainingsZiel, DateTime.UtcNow, Sitzung.Zustand.Zufall);
        await Sitzung.SpeichernAsync();
    }

    private List<Ausruestung> VerfuegbareAusruestung(AusruestungsSlot slot) => Sitzung.Zustand.Ausruestungen
        .Where(a => a.AngelegtBeiPferdId == null && Inhalte.HoleAusruestung(a.DefinitionId).Slot == slot).ToList();

    private async Task Anlegen(AusruestungsSlot slot)
    {
        if (_pferd == null) return;

        // Ohne "- wählen -"-Platzhalter zeigt der Browser von sich aus schon das erste Element an,
        // bevor @bind das C#-Feld nachzieht - ohne expliziten Wechsel bliebe es sonst leer.
        var idText = _ausgewaehlteAusruestung.GetValueOrDefault(slot);
        var ausruestung = string.IsNullOrEmpty(idText)
            ? VerfuegbareAusruestung(slot).FirstOrDefault()
            : Sitzung.Zustand.Ausruestungen.FirstOrDefault(a => a.Id.ToString() == idText);
        if (ausruestung == null) return;

        Sitzung.Zustand.RuesteAus(_pferd, ausruestung, slot);
        await Sitzung.SpeichernAsync();
    }

    private async Task Ablegen(AusruestungsSlot slot)
    {
        if (_pferd == null) return;
        Sitzung.Zustand.RuesteAb(_pferd, slot);
        await Sitzung.SpeichernAsync();
    }

    // Invariant formatieren: CSS versteht kein Komma als Dezimaltrennzeichen, die deutsche
    // Kultur würde hier sonst "71,0%" statt "71.0%" erzeugen und der Browser ignoriert den Wert.
    private static string Prozent(float wert) =>
        Math.Clamp(wert, 0, 100).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
