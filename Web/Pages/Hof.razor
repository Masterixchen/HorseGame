@page "/hof"
@using Core
@using Web.Speicher
@inject SpielSitzung Sitzung

<PageTitle>Hof</PageTitle>

@if (!Sitzung.Geladen)
{
    <p>Lädt...</p>
}
else
{
    <div class="stall-kopf">
        <h1>Hof</h1>
        <button class="knopf-sekundaer" @onclick="Aktualisieren">Aktualisieren</button>
    </div>
    <p class="karte-unterzeile">Jedes Gebäude wirkt konkret auf die Zucht - welches gerade begrenzt, steht in der Zuchtplanung.</p>

    @if (_meldung != null)
    {
        <p class="erfolgsmeldung">@_meldung</p>
    }
    @if (_fehler != null)
    {
        <p class="fehlermeldung">@_fehler</p>
    }

    <section class="detail-abschnitt">
        <h2>Weide</h2>
        <div class="weide-flaeche">
            @foreach (var pferd in AufDerWeide)
            {
                <span class="weide-pferd" style="background:@HorseArt.FarbeAlsHex(pferd.Farbe)" title="@pferd.Name"></span>
            }
            @if (AufDerWeide.Count == 0)
            {
                <span class="karte-unterzeile">Gerade ist niemand draußen.</span>
            }
        </div>
        @if (ImStall.Count > 0)
        {
            <p class="karte-unterzeile">Im Stall beschäftigt:</p>
            <div class="weide-flaeche weide-stall">
                @foreach (var pferd in ImStall)
                {
                    <span class="weide-pferd" style="background:@HorseArt.FarbeAlsHex(pferd.Farbe)" title="@pferd.Name"></span>
                }
            </div>
        }
    </section>

    <div class="gebaeude-raster">
        @foreach (var gebaeude in Enum.GetValues<Gebaeude>())
        {
            int stufe = Sitzung.Zustand.GebaeudeStufe(gebaeude);
            bool baustelle = Sitzung.Zustand.LaufenderAusbau?.Gebaeude == gebaeude;
            <div class="gebaeude-karte @(baustelle ? "gebaeude-baustelle" : "")">
                <div class="karte-kopf">
                    <span class="pferde-name">@Anzeigename(gebaeude)</span>
                    <span class="seltenheit-abzeichen">Stufe @stufe</span>
                </div>
                <div class="karte-unterzeile">@Beschreibung(gebaeude, stufe)</div>
                @if (baustelle)
                {
                    <p class="fohlen-hinweis">🚧 im Bau</p>
                    <Fortschrittsbalken Start="Sitzung.Zustand.LaufenderAusbau!.Beginn" Ende="Sitzung.Zustand.LaufenderAusbau!.Fertig" />
                }
                else
                {
                    <div class="karte-unterzeile"><em>nach Ausbau: @Beschreibung(gebaeude, stufe + 1)</em></div>
                    <button class="knopf-primaer" disabled="@(Sitzung.Zustand.LaufenderAusbau != null)"
                            @onclick="() => Ausbauen(gebaeude)">
                        Ausbauen (@Sitzung.Zustand.HofAusbauKosten(gebaeude).ToString("N0"))
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private string? _meldung;
    private string? _fehler;

    // Nur eine Anzeigesache (siehe Phase-4-Auftrag, Block 4: "stärkster einzelner Hebel gegen den
    // Eindruck, das Spiel sei tot") - bewusst eine eigene, einfachere Definition als
    // Pferd.IstBeschaeftigt, die auch laufendes Training und wachsende Fohlen mit einschließt.
    private static bool IstImStall(Pferd pferd) =>
        pferd.Traechtigkeit != null || pferd.LaufendesTraining != null || !pferd.AlleMerkmaleBekannt;

    private List<Pferd> AufDerWeide => Sitzung.Zustand.Pferde.Where(p => !IstImStall(p)).ToList();
    private List<Pferd> ImStall => Sitzung.Zustand.Pferde.Where(IstImStall).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Sitzung.Geladen)
            await Sitzung.LadenOderErzeugenAsync();
    }

    private async Task Aktualisieren()
    {
        Sitzung.Zustand.Advance(DateTime.UtcNow);
        await Sitzung.SpeichernAsync();
    }

    private async Task Ausbauen(Gebaeude gebaeude)
    {
        _fehler = null;
        _meldung = null;
        try
        {
            Sitzung.Zustand.HofAusbauen(gebaeude, DateTime.UtcNow);
            _meldung = $"Ausbau von {Anzeigename(gebaeude)} gestartet.";
            await Sitzung.SpeichernAsync();
        }
        catch (InvalidOperationException ex)
        {
            _fehler = ex.Message;
        }
    }

    // "FutterlagerUndVerwaltung" -> "Futterlager Und Verwaltung": vor jedem Großbuchstaben
    // (außer am Anfang) ein Leerzeichen, "Und" danach klein.
    private static string Anzeigename(Gebaeude gebaeude) =>
        System.Text.RegularExpressions.Regex.Replace(gebaeude.ToString(), "(?<!^)([A-Z])", " $1")
            .Replace(" Und ", " und ");

    private static string Beschreibung(Gebaeude gebaeude, int stufe) => gebaeude switch
    {
        Gebaeude.Zuchtstall =>
            $"Blutlinienstufe maximal {GebaeudeRegeln.MaxBlutlinienstufe(stufe)}, Trächtigkeit {GebaeudeRegeln.Traechtigkeitsdauer(stufe).TotalHours:0.#} Std.",
        Gebaeude.Fohlenaufzucht =>
            $"Werte des Fohlens streuen zwischen {GebaeudeRegeln.MinWerteStreuung(stufe) * 100:0}% und 110% des Eltern-Durchschnitts.",
        Gebaeude.Genetiklabor =>
            $"Merkmale decken sich in {GebaeudeRegeln.AufdeckZeitraum(stufe).MinStunden:0.#} bis {GebaeudeRegeln.AufdeckZeitraum(stufe).MaxStunden:0.#} Std. auf" +
            (stufe >= GebaeudeRegeln.GenetiklaborDetailstufe ? ", Vorschau zeigt einzelne Merkmalschancen." : "."),
        Gebaeude.Weide => $"Erholung und Stimmung aller Pferde +{GebaeudeRegeln.ErholungsBonusProzent(stufe):0}%.",
        Gebaeude.Deckstation =>
            $"{GebaeudeRegeln.MaxGleichzeitigeTraechtigkeiten(stufe)} gleichzeitige Trächtigkeit(en), {GebaeudeRegeln.MaterialRueckerstattungsChance(stufe) * 100:0}% Chance auf Materialrückerstattung.",
        Gebaeude.Tierarztstation => "Wirkt sich aus, sobald es ein Verletzungssystem gibt (noch nicht umgesetzt).",
        Gebaeude.FutterlagerUndVerwaltung =>
            $"Unterhalt ×{GebaeudeRegeln.UnterhaltsMultiplikator(stufe):0.00}, {GebaeudeRegeln.AnzahlMarktpferde(stufe)} Pferde im Markt.",
        _ => ""
    };
}
